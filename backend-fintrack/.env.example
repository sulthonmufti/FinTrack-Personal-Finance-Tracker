# Konfigurasi Database PostgreSQL
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_DATABASE=fintrack_db
DB_PORT=5432

# JWT Secret Key - Ganti dengan string random yang panjang dan aman
JWT_SECRET=your_super_secret_jwt_key_here

# Port Server Backend (opsional, default: 5000)
PORT=5000
